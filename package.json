{
  "name": "dsh-dr-panda-mcp",
  "version": "0.2.0",
  "description": "DeepSeek Harness carrier that bridges a running DrPanda MCP service into the agent over Streamable HTTP (mcp__drpanda__*).",
  "license": "MIT",
  "author": "linyu19872008",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "mcp",
    "model-context-protocol",
    "dr-panda",
    "drpanda",
    "incident-response",
    "troubleshooting",
    "observability"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.mjs\"",
    "check": "node --check lib/index.js && node --check lib/settings.js && node --check lib/bridge.js && node --check lib/routes.js && node --check lib/probe.js && node --check lib/credentials.js && node --check lib/doctor-support.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/linyu19872008/dsh-dr-panda-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/linyu19872008/dsh-dr-panda-mcp/issues"
  },
  "homepage": "https://github.com/linyu19872008/dsh-dr-panda-mcp#readme",
  "publishConfig": {
    "access": "public"
  }
}
